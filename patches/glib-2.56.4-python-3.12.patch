+def _version_key(version):
+    # distutils was removed from Python 3.12. GDBus version annotations are
+    # normally numeric, but retain deterministic ordering for textual parts.
+    parts = re.findall(r'\d+|[a-zA-Z]+', version)
+    return tuple((0, int(part)) if part.isdigit() else (1, part.lower())
+                 for part in parts)
+
